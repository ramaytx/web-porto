<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit <%= section.charAt(0).toUpperCase() + section.slice(1) %> - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
    <style>
        body {
            background-color: #f3f4f6;
        }

        .form-card {
            background: white;
            border-radius: 12px;
            padding: 2rem;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            margin-bottom: 1.5rem;
        }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="bg-gradient-to-r from-blue-600 to-purple-600 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold">Edit <%= section.charAt(0).toUpperCase() + section.slice(1) %>
                </h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="/admin" class="bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold hover:bg-blue-50">
                    ← Back to Dashboard
                </a>
                <a href="/admin/logout"
                    class="bg-red-500 text-white px-4 py-2 rounded-lg font-semibold hover:bg-red-600">
                    Logout
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-5xl mx-auto px-6 py-8">
        <div id="message" class="hidden mb-4"></div>

        <% if (section==='profile' ) { %>
            <!-- Profile Form -->
            <div class="form-card">
                <h2 class="text-xl font-bold mb-4">Profile Information</h2>
                <form id="profileForm">
                    <input type="hidden" name="section" value="profile">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block font-semibold mb-2">Name</label>
                            <input type="text" name="name" value="<%= data.profile.name %>"
                                class="w-full px-4 py-2 border rounded-lg" required>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">Location</label>
                            <input type="text" name="location" value="<%= data.profile.location %>"
                                class="w-full px-4 py-2 border rounded-lg" required>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">Phone</label>
                            <input type="text" name="phone" value="<%= data.profile.phone %>"
                                class="w-full px-4 py-2 border rounded-lg" required>
                        </div>
                        <div>
                            <label class="block font-semibold mb-2">Email</label>
                            <input type="email" name="email" value="<%= data.profile.email %>"
                                class="w-full px-4 py-2 border rounded-lg" required>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-semibold mb-2">LinkedIn URL</label>
                            <input type="url" name="linkedin" value="<%= data.profile.linkedin %>"
                                class="w-full px-4 py-2 border rounded-lg" required>
                        </div>
                        <div class="md:col-span-2">
                            <label class="block font-semibold mb-2">About</label>
                            <textarea name="about" rows="4" class="w-full px-4 py-2 border rounded-lg"
                                required><%= data.profile.about %></textarea>
                        </div>
                    </div>
                    <button type="submit"
                        class="mt-4 bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700">
                        Save Profile
                    </button>
                </form>
            </div>

            <% } else if (section==='skills' || section==='certifications' || section==='publications' ) { %>
                <!-- Simple Array Management -->
                <div class="form-card">
                    <h2 class="text-xl font-bold mb-4">Manage <%= section.charAt(0).toUpperCase() + section.slice(1) %>
                    </h2>
                    <div id="itemsList" class="mb-4">
                        <% data[section].forEach((item, index)=> { %>
                            <div class="flex items-center gap-2 mb-2 item-row">
                                <input type="text" value="<%= item %>"
                                    class="flex-1 px-4 py-2 border rounded-lg item-input">
                                <button onclick="removeItem(this)"
                                    class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Remove</button>
                            </div>
                            <% }); %>
                    </div>
                    <button onclick="addItem()"
                        class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 mb-4">
                        + Add <%= section==='skills' ? 'Skill' : section==='certifications' ? 'Certification'
                            : 'Publication' %>
                    </button>
                    <br>
                    <button onclick="saveSimple Arr()"
                        class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700">
                        Save All
                    </button>
                </div>

                <% } else { %>
                    <!-- Complex Array Management (Education, Experience, Projects, Organization) -->
                    <button onclick="showAddForm()"
                        class="bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 mb-6">
                        + Add New <%= section.charAt(0).toUpperCase() + section.slice(1).slice(0, -1) %>
                    </button>

                    <!-- Add/Edit Form (Hidden by default) -->
                    <div id="itemForm" class="form-card hidden">
                        <h2 class="text-xl font-bold mb-4" id="formTitle">Add New</h2>
                        <form id="complexForm">
                            <input type="hidden" name="section" value="<%= section %>">
                            <input type="hidden" name="id" id="itemId">

                            <% if (section==='education' ) { %>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div class="md:col-span-2">
                                        <label class="block font-semibold mb-2">Degree/Program</label>
                                        <input type="text" name="degree" id="degree"
                                            class="w-full px-4 py-2 border rounded-lg" required>
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block font-semibold mb-2">School/University</label>
                                        <input type="text" name="school" id="school"
                                            class="w-full px-4 py-2 border rounded-lg" required>
                                    </div>
                                    <div>
                                        <label class="block font-semibold mb-2">Dates</label>
                                        <input type="text" name="dates" id="dates"
                                            placeholder="e.g. Jun 2020 - Sep 2024"
                                            class="w-full px-4 py-2 border rounded-lg" required>
                                    </div>
                                    <div>
                                        <label class="block font-semibold mb-2">GPA (Optional)</label>
                                        <input type="text" name="gpa" id="gpa"
                                            class="w-full px-4 py-2 border rounded-lg">
                                    </div>
                                    <div class="md:col-span-2">
                                        <label class="block font-semibold mb-2">Highlights (one per line)</label>
                                        <textarea name="highlight" id="highlight" rows="4"
                                            class="w-full px-4 py-2 border rounded-lg"
                                            placeholder="Enter each highlight on a new line" required></textarea>
                                    </div>
                                </div>

                                <% } else if (section==='experience' ) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <div class="md:col-span-2">
                                            <label class="block font-semibold mb-2">Company</label>
                                            <input type="text" name="company" id="company"
                                                class="w-full px-4 py-2 border rounded-lg" required>
                                        </div>
                                        <div class="md:col-span-2">
                                            <label class="block font-semibold mb-2">Role/Position</label>
                                            <input type="text" name="role" id="role"
                                                class="w-full px-4 py-2 border rounded-lg" required>
                                        </div>
                                        <div class="md:col-span-2">
                                            <label class="block font-semibold mb-2">Dates</label>
                                            <input type="text" name="dates" id="dates"
                                                placeholder="e.g. Jan 2023 - Present"
                                                class="w-full px-4 py-2 border rounded-lg" required>
                                        </div>
                                        <div class="md:col-span-2">
                                            <label class="block font-semibold mb-2">Highlights (one per line)</label>
                                            <textarea name="highlight" id="highlight" rows="4"
                                                class="w-full px-4 py-2 border rounded-lg"
                                                placeholder="Enter each highlight on a new line" required></textarea>
                                        </div>
                                    </div>

                                    <% } else if (section==='projects' ) { %>
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                            <div class="md:col-span-2">
                                                <label class="block font-semibold mb-2">Project Title</label>
                                                <input type="text" name="title" id="title"
                                                    class="w-full px-4 py-2 border rounded-lg" required>
                                            </div>
                                            <div class="md:col-span-2">
                                                <label class="block font-semibold mb-2">Description</label>
                                                <textarea name="description" id="description" rows="3"
                                                    class="w-full px-4 py-2 border rounded-lg" required></textarea>
                                            </div>
                                            <div>
                                                <label class="block font-semibold mb-2">Year</label>
                                                <input type="text" name="year" id="year" placeholder="e.g. 2024"
                                                    class="w-full px-4 py-2 border rounded-lg" required>
                                            </div>
                                            <div>
                                                <label class="block font-semibold mb-2">Type/Category</label>
                                                <input type="text" name="type" id="type"
                                                    placeholder="e.g. Web Development"
                                                    class="w-full px-4 py-2 border rounded-lg" required>
                                            </div>
                                            <div class="md:col-span-2">
                                                <label class="block font-semibold mb-2">Technologies (comma
                                                    separated)</label>
                                                <input type="text" name="tech" id="tech"
                                                    placeholder="e.g. HTML, CSS, JavaScript"
                                                    class="w-full px-4 py-2 border rounded-lg" required>
                                            </div>
                                        </div>

                                        <% } else if (section==='organization' ) { %>
                                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                                <div class="md:col-span-2">
                                                    <label class="block font-semibold mb-2">Organization Name</label>
                                                    <input type="text" name="org" id="org"
                                                        class="w-full px-4 py-2 border rounded-lg" required>
                                                </div>
                                                <div class="md:col-span-2">
                                                    <label class="block font-semibold mb-2">Role/Position</label>
                                                    <input type="text" name="role" id="role"
                                                        class="w-full px-4 py-2 border rounded-lg" required>
                                                </div>
                                                <div class="md:col-span-2">
                                                    <label class="block font-semibold mb-2">Dates</label>
                                                    <input type="text" name="dates" id="dates"
                                                        placeholder="e.g. 2021-2023"
                                                        class="w-full px-4 py-2 border rounded-lg" required>
                                                </div>
                                                <div class="md:col-span-2">
                                                    <label class="block font-semibold mb-2">Highlights (one per
                                                        line)</label>
                                                    <textarea name="highlight" id="highlight" rows="4"
                                                        class="w-full px-4 py-2 border rounded-lg"
                                                        placeholder="Enter each highlight on a new line"
                                                        required></textarea>
                                                </div>
                                            </div>
                                            <% } %>

                                                <div class="flex gap-4 mt-6">
                                                    <button type="submit"
                                                        class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700">
                                                        Save
                                                    </button>
                                                    <button type="button" onclick="cancelForm()"
                                                        class="bg-gray-500 text-white px-6 py-3 rounded-lg font-semibold hover:bg-gray-600">
                                                        Cancel
                                                    </button>
                                                </div>
                        </form>
                    </div>

                    <!-- Items List -->
                    <div id="itemsList">
                        <% data[section].forEach((item, index)=> { %>
                            <div class="form-card">
                                <div class="flex justify-between items-start">
                                    <div class="flex-1">
                                        <% if (section==='education' ) { %>
                                            <h3 class="text-lg font-bold">
                                                <%= item.degree %>
                                            </h3>
                                            <p class="text-gray-600">
                                                <%= item.school %>
                                            </p>
                                            <p class="text-sm text-gray-500">
                                                <%= item.dates %>
                                            </p>
                                            <% if (item.gpa) { %>
                                                <p class="text-sm text-gray-500">GPA: <%= item.gpa %>
                                                </p>
                                                <% } %>
                                                    <% } else if (section==='experience' ) { %>
                                                        <h3 class="text-lg font-bold">
                                                            <%= item.role %>
                                                        </h3>
                                                        <p class="text-gray-600">
                                                            <%= item.company %>
                                                        </p>
                                                        <p class="text-sm text-gray-500">
                                                            <%= item.dates %>
                                                        </p>
                                                        <% } else if (section==='projects' ) { %>
                                                            <h3 class="text-lg font-bold">
                                                                <%= item.title %>
                                                            </h3>
                                                            <p class="text-gray-600 text-sm">
                                                                <%= item.description %>
                                                            </p>
                                                            <p class="text-sm text-gray-500">
                                                                <%= item.year %> • <%= item.type %>
                                                            </p>
                                                            <% } else if (section==='organization' ) { %>
                                                                <h3 class="text-lg font-bold">
                                                                    <%= item.role %>
                                                                </h3>
                                                                <p class="text-gray-600">
                                                                    <%= item.org %>
                                                                </p>
                                                                <p class="text-sm text-gray-500">
                                                                    <%= item.dates %>
                                                                </p>
                                                                <% } %>
                                    </div>
                                    <div class="flex gap-2">
                                        <button onclick='editItem(<%= JSON.stringify(item) %>)'
                                            class="bg-yellow-500 text-white px-4 py-2 rounded-lg hover:bg-yellow-600">
                                            Edit
                                        </button>
                                        <button onclick="deleteItem('<%= item.id %>')"
                                            class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">
                                            Delete
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                    <% } %>
    </main>

    <script>
        const section = '<%= section %>';

    // Profile form
    <% if (section === 'profile') { %>
            document.getElementById('profileForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                const itemData = {};
                formData.forEach((value, key) => {
                    if (key !== 'section') itemData[key] = value;
                });

                const result = await saveData('profile', itemData);
                showMessage(result.message, result.success ? 'success' : 'error');
            });
    <% } %>

    // Simple array functions
    <% if (section === 'skills' || section === 'certifications' || section === 'publications') { %>
            function addItem() {
                const container = document.getElementById('itemsList');
                const div = document.createElement('div');
                div.className = 'flex items-center gap-2 mb-2 item-row';
                div.innerHTML = `
        <input type="text" class="flex-1 px-4 py-2 border rounded-lg item-input">
        <button onclick="removeItem(this)" class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600">Remove</button>
      `;
                container.appendChild(div);
            }

            function removeItem(btn) {
                btn.parentElement.remove();
            }

            async function saveSimpleArr() {
                const inputs = document.querySelectorAll('.item-input');
                const items = Array.from(inputs).map(input => input.value.trim()).filter(v => v);
                const result = await saveData(section, items);
                showMessage(result.message, result.success ? 'success' : 'error');
                if (result.success) setTimeout(() => location.reload(), 1500);
            }
    <% } %>

    // Complex form functions
    <% if (section !== 'profile' && section !== 'skills' && section !== 'certifications' && section !== 'publications') { %>
            function showAddForm() {
                document.getElementById('itemForm').classList.remove('hidden');
                document.getElementById('formTitle').textContent = 'Add New';
                document.getElementById('complexForm').reset();
                document.getElementById('itemId').value = '';
            }

            function cancelForm() {
                document.getElementById('itemForm').classList.add('hidden');
                document.getElementById('complexForm').reset();
            }

            function editItem(item) {
                document.getElementById('itemForm').classList.remove('hidden');
                document.getElementById('formTitle').textContent = 'Edit';
                document.getElementById('itemId').value = item.id;

                for (let key in item) {
                    const field = document.getElementById(key);
                    if (field) {
                        if (key === 'highlight') {
                            field.value = item[key].join('\n');
                        } else if (key === 'tech') {
                            field.value = item[key].join(', ');
                        } else {
                            field.value = item[key];
                        }
                    }
                }
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            async function deleteItem(id) {
                if (!confirm('Are you sure you want to delete this item?')) return;

                const response = await fetch(`/admin/delete/${section}/${id}`, { method: 'POST' });
                const result = await response.json();
                showMessage(result.message, result.success ? 'success' : 'error');
                if (result.success) setTimeout(() => location.reload(), 1500);
            }

            document.getElementById('complexForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(e.target);
                const itemData = {};

                formData.forEach((value, key) => {
                    if (key === 'section') return;
                    if (key === 'highlight') {
                        itemData[key] = value.split('\n').map(s => s.trim()).filter(s => s);
                    } else if (key === 'tech') {
                        itemData[key] = value.split(',').map(s => s.trim()).filter(s => s);
                    } else if (key === 'id' && value) {
                        itemData[key] = value;
                    } else if (key !== 'id') {
                        itemData[key] = value;
                    }
                });

                const result = await saveData(section, itemData);
                showMessage(result.message, result.success ? 'success' : 'error');
                if (result.success) setTimeout(() => location.reload(), 1500);
            });
    <% } %>

            async function saveData(section, itemData) {
                const response = await fetch('/admin/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ section, itemData })
                });
                return await response.json();
            }

        function showMessage(msg, type) {
            const el = document.getElementById('message');
            el.textContent = msg;
            el.className = type === 'success'
                ? 'bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4'
                : 'bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4';
            el.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>

</html>